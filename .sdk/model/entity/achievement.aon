# Entity: achievement

main: kit: entity: achievement: {

  alias: field: {}

  fields: [
    {
      name: "id"
      req: false
      short: "Achievement ID"
      type: "`$INTEGER`"
    }
    {
      name: "level"
      req: false
      short: "Achievement level"
      type: "`$INTEGER`"
    }
    {
      name: "neko_id"
      req: false
      short: "Neko achievement identifier"
      type: "`$STRING`"
    }
    {
      name: "progress"
      req: false
      short: "Progress towards next level"
      type: "`$INTEGER`"
    }
    {
      name: "user_id"
      req: false
      short: "User ID"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "achievement"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "user_id"
                orig: "user_id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/achievements"
          segments: [
            {
              lit: "achievements"
            }
          ]
          select: {
            exist: [
              "user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
